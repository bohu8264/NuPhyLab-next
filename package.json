{
  "name": "nuphy-lab",
  "version": "1.2.54",
  "private": true,
  "type": "module",
  "description": "NuPhy Lab lighting and AI keyboard controls",
  "scripts": {
    "setup": "npm --prefix ui install",
    "build:native": "node scripts/build-native.mjs",
    "build:ui": "npm --prefix ui run build",
    "build:icon": "node scripts/build-icon.mjs",
    "fetch-node": "node scripts/fetch-node.mjs",
    "build": "npm run build:icon && npm run build:native && npm run build:ui",
    "start": "node server/main.mjs",
    "test": "node --test --test-concurrency=2 tests/*.test.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "windows:prepare": "node scripts/windows/prepare.mjs",
    "windows:dev": "node scripts/windows/run.mjs dev",
    "windows:build": "node scripts/windows/run.mjs build",
    "windows:release": "node scripts/windows/run.mjs build --signed",
    "windows:probe": "node scripts/windows/probe.mjs",
    "windows:test": "node scripts/windows/test.mjs"
  },
  "devDependencies": {"@tauri-apps/cli":"2.12.4"},
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bohu8264/NuPhyLab-next.git"
  },
  "homepage": "https://github.com/bohu8264/NuPhyLab-next",
  "bugs": {
    "url": "https://github.com/bohu8264/NuPhyLab-next/issues"
  }
}
