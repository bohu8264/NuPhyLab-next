{
  "profile": "windows-lighting-v5",
  "protocolVersion": 5,
  "implementation": "windows-lighting-controller",
  "maxLineBytes": 32768,
  "maxPending": 8,
  "handshakeTimeoutMs": 3000,
  "heartbeatIntervalMs": 1000,
  "heartbeatReplyTimeoutMs": 3000,
  "heartbeatTimeoutMs": 5000,
  "requestTimeoutMs": 120000,
  "operationTimeoutMs": 30000,
  "maxFrameAgeMs": 500,
  "shutdownTimeoutMs": 3000,
  "operations": [
    "arm",
    "armNative",
    "armConnectionWake",
    "nativeLighting",
    "nativeSnapshot",
    "paint",
    "side",
    "restore",
    "recoveryStatus",
    "recoverExisting",
    "heartbeat",
    "quit"
  ],
  "capabilities": {
    "lightingWrite": true,
    "recoveryJournal": true,
    "coldRecovery": true,
    "nativeLighting": true,
    "boardSleepLease": true,
    "keymapWrite": false,
    "functionKeyRecords": true,
    "globalKeys": false,
    "audioCapture": false,
    "agentControl": false,
    "connectionWake": true
  }
}
