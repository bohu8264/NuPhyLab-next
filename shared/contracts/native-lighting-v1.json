{
  "profile": "windows-lighting-v1",
  "protocolVersion": 1,
  "implementation": "windows-lighting-controller",
  "maxLineBytes": 32768,
  "maxPending": 8,
  "handshakeTimeoutMs": 3000,
  "heartbeatIntervalMs": 1000,
  "heartbeatReplyTimeoutMs": 3000,
  "heartbeatTimeoutMs": 5000,
  "requestTimeoutMs": 120000,
  "operationTimeoutMs": 30000,
  "maxFrameAgeMs": 500,
  "shutdownTimeoutMs": 3000,
  "operations": ["arm", "paint", "side", "restore", "heartbeat", "quit"],
  "capabilities": {
    "lightingWrite": true,
    "recoveryJournal": true,
    "boardSleepLease": true,
    "keymapWrite": false,
    "globalKeys": false,
    "audioCapture": false,
    "agentControl": false
  }
}
